<resources>
    <style name="Theme.SafeInCloud" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sic_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/sic_secondary</item>
        <item name="colorSurface">@color/sic_surface</item>
        <item name="colorOnSurface">@color/sic_ink</item>
        <item name="android:colorAccent">@color/sic_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/sic_background</item>
        <item name="android:navigationBarColor">@color/sic_surface</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.SafeInCloud.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
